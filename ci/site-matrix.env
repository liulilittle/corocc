# corocc site matrix: per-site floors consumed by scripts/ci/build-test.sh and
# scripts/ci-local.sh.
# Columns: site|class|toolchain|apt|excludes|expected_registered|expected_executed
#   registered = raw `ctest -N` count (no -E) >= value -- reconciliation column
#                (unchanged when the exclude list changes)
#   executed   = `ctest -N -E <excludes>` (same -E as the run) >= value
#   the global constant ALL_EXCL='cpp_perf' is built into scripts/ci/build-test.sh;
#   the excludes column below lists site-level additions only
#   cross rows: apt = "qemu-user + matrix.apt" (qemu-user installed by the job,
#   matrix.apt in .github/workflows/ci.yml; the 14 g++-<triple> packages
#   (aarch64, armhf, armel, mips_o32, mipsel_o32, mips64_n64, mips64el_n64,
#   ppc32, ppc64, ppc64le, s390x, riscv64, loongarch64, sparc64) are part of
#   matrix.apt and required by project() language detection; i386 also needs
#   lib32stdc++-13-dev for the CXX detection link)
#   boost variants (image ships Boost/Python coexistence suites => +1):
#   native 46|45, nospin 47|46, asan 45|42 -- the rows below keep the no-boost
#   floor; the script asserts ">=" so images with Boost pass as well
#   B1: the rt_driver_registry suite enters the default ctest population on every
#   site whose row is a floor (native x3, nospin, asan, windows x3, all cross),
#   so each floor is +1 over its pre-B1 value. tsan counts only the -R
#   conc_runtime_tsan selection (1|1): the new suite is not in that selection,
#   so its row is unchanged. Rows at n/a run no gated population.
native-gcc|native||ninja ccache||45|44
native-clang|native||ninja ccache||45|44
native-arm64|native||ninja ccache||45|44
nospin|native||ninja||46|45
asan|native||ninja|coro_exactlyonce coro_crossresume conc_double_resume|44|41
tsan|native||ninja|(select: -R conc_runtime_tsan; macro passed by the caller, cache assertion; -Wno-error=tsan for gcc -Wtsan x -Werror)|1|1
cross-aarch64|cross|scripts/toolchains/aarch64.cmake|qemu-user + matrix.apt| |35|35
cross-armhf|cross|scripts/toolchains/arm32.cmake|qemu-user + matrix.apt| |35|35
cross-armel|cross|scripts/toolchains/armel.cmake|qemu-user + matrix.apt| |35|35
cross-i386|cross|scripts/toolchains/i386.cmake|qemu-user + matrix.apt| |35|35
cross-mips_o32|cross|scripts/toolchains/mips32.cmake|qemu-user + matrix.apt| |35|35
cross-mipsel_o32|cross|scripts/toolchains/mips32el.cmake|qemu-user + matrix.apt| |35|35
cross-mips64_n64|cross|scripts/toolchains/mips64.cmake|qemu-user + matrix.apt| |35|35
cross-mips64el_n64|cross|scripts/toolchains/mips64el.cmake|qemu-user + matrix.apt| |35|35
cross-ppc32|cross|scripts/toolchains/ppc32.cmake|qemu-user + matrix.apt| |35|35
cross-ppc64|cross|scripts/toolchains/ppc64.cmake|qemu-user + matrix.apt| |35|35
cross-ppc64le|cross|scripts/toolchains/ppc64le.cmake|qemu-user + matrix.apt| |35|35
cross-s390x|cross|scripts/toolchains/s390x.cmake|qemu-user + matrix.apt| |35|35
cross-riscv64|cross|scripts/toolchains/riscv64.cmake|qemu-user + matrix.apt| |35|35
cross-loongarch64|cross|scripts/toolchains/loongarch64.cmake|qemu-user + matrix.apt| |35|35
cross-sparc64|cross|scripts/toolchains/sparc64.cmake|qemu-user + matrix.apt| |35|35
# prebuilt toolchain-v1 asset rows (fetched via the ci.yml assets: field):
cross-aarch64_be|cross|scripts/toolchains/aarch64_be.cmake|qemu-user + matrix.apt| |35|35
cross-armeb|cross|scripts/toolchains/armeb.cmake|qemu-user + matrix.apt| |35|35
cross-riscv32|cross|scripts/toolchains/riscv32.cmake|qemu-user + matrix.apt| |35|35
# mips N32 (apt multilib route; no prebuilt assets; perf/bench excluded):
cross-mipsn32|cross|scripts/toolchains/mipsn32.cmake|qemu-user + matrix.apt|perf bench|35|35
cross-mipsn32el|cross|scripts/toolchains/mipsn32el.cmake|qemu-user + matrix.apt|perf bench|35|35
boost-asio|build||libboost-dev clang| |n/a|n/a
macos-x64|build||(Xcode clang + cmake preinstalled)| |n/a|n/a
macos-arm64|build||(Xcode clang + cmake preinstalled)| |n/a|n/a
windows-msvc|native|VS2022||(Release ctest; Debug build-only)|43|43
windows-x86|native|VS2022 Win32||(Release ctest; Debug build-only)|43|43
windows-arm64|native|VS2026 ARM64||(Release ctest; Debug build-only)|43|43
ndk-arm64-v8a|build|scripts/toolchains/android-ndk.cmake|ninja| |n/a|n/a
ndk-x86_64|build|scripts/toolchains/android-ndk.cmake|ninja| |n/a|n/a
ndk-armeabi-v7a|build|scripts/toolchains/android-ndk.cmake|ninja| |n/a|n/a
ndk-x86|build|scripts/toolchains/android-ndk.cmake|ninja| |n/a|n/a
asio-host-example|build||libboost-dev clang| |n/a|n/a
