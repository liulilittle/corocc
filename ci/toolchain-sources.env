# corocc toolchain sources -- machine-readable single source for the
# docs/toolchains.md, docs/toolchains.zh-CN.md and release-body tables.
#
# Consumed on demand by scripts/ci/gen-toolchain-table.sh (NOT wired into CI;
# no workflow references this file, so ci/check-workflows.sh is unaffected).
#
# Columns: site|triple|source|detail|assets
#   site     ci/site-matrix.env row key (cross-<abi> / ndk-<abi> / job id).
#            `headers` and `perf-report` are ci.yml jobs with no table row.
#   triple   GNU target triple of the site (descriptive for the PE/Mach-O
#            and Android sites).
#   source   curated source-kind key, one of:
#              apt           cross packages installed by apt (the package
#                            list is derived from the ci.yml `apt:` field)
#              host-m32      host gcc/g++ driven with -m32 (i386)
#              prebuilt-v1   toolchain-v1 release assets + apt binutils
#              runner-image  the GitHub runner image toolchain
#              xcode         Xcode clang (macOS runner image)
#              vs2022        Visual Studio 2022 (MSVC)
#              vs2026        Visual Studio 2026 (MSVC / armasm64)
#              ndk           Android NDK r26+ clang (preinstalled)
#   detail   extra language-neutral text appended to the source label
#            (apt package names for the example jobs); empty otherwise.
#   assets   prebuilt asset names, ';'-separated; only the prebuilt-v1 rows.
#            The sha256 of every name is looked up in ci/toolchain-assets.sha256.
#
# Every fact above is cross-checked by gen-toolchain-table.sh against the
# authoritative files (ci.yml, release.yml, site-matrix.env, the sha256
# ledger); the site set must match exactly or the generator exits 1.
#
# --- cross sites (ci.yml `cross` matrix / release.yml prebuild-linux) ---
cross-aarch64|aarch64-unknown-linux-gnu|apt||
cross-armhf|arm-linux-gnueabihf|apt||
cross-armel|arm-linux-gnueabi|apt||
cross-i386|i386-unknown-linux-gnu|host-m32||
cross-mips_o32|mips-unknown-linux-gnu|apt||
cross-mipsel_o32|mipsel-unknown-linux-gnu|apt||
cross-mips64_n64|mips64-unknown-linux-gnuabi64|apt||
cross-mips64el_n64|mips64el-unknown-linux-gnuabi64|apt||
cross-ppc32|powerpc-unknown-linux-gnu|apt||
cross-ppc64|powerpc64-unknown-linux-gnu|apt||
cross-ppc64le|powerpc64le-unknown-linux-gnu|apt||
cross-s390x|s390x-unknown-linux-gnu|apt||
cross-riscv64|riscv64-unknown-linux-gnu|apt||
cross-loongarch64|loongarch64-unknown-linux-gnu|apt||
cross-sparc64|sparc64-unknown-linux-gnu|apt||
cross-aarch64_be|aarch64_be-unknown-linux-gnu|prebuilt-v1||corocc-toolchain-aarch64_be-linux-gnu-gcc13.3.0-glibc2.39.tar.gz;corocc-sysroot-aarch64_be-linux-gnu-glibc2.39.tar.gz
cross-armeb|armeb-unknown-linux-gnueabi|prebuilt-v1||corocc-toolchain-armeb-linux-gnueabi-gcc13.3.0-glibc2.39.tar.gz;corocc-sysroot-armeb-linux-gnueabi-glibc2.39.tar.gz
cross-riscv32|riscv32-unknown-linux-gnu|prebuilt-v1||corocc-toolchain-riscv32-linux-gnu-gcc13.3.0-glibc2.39.tar.gz;corocc-sysroot-riscv32-linux-gnu-glibc2.39.tar.gz
cross-mipsn32|mips64-unknown-linux-gnuabin32|apt||
cross-mipsn32el|mips64el-unknown-linux-gnuabin32|apt||
